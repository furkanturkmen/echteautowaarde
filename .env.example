# Backend configuration for the local FastAPI application.
# Copy to .env and adjust only what you need — every value has a working local default.

# SQLite database file (absolute path, or relative to where you start the API).
# EAW_DATABASE_PATH=data/automotive.db

# Local AI explanation layer (Ollama). Entirely optional: the valuation, the
# comparables and the result page work unchanged when this is off or the model
# is missing. Nothing is ever downloaded by the application - pull a model
# yourself with `ollama pull <model>`.
#
# The model must follow instructions in Dutch; code models are a poor fit.
# EAW_AI_ENABLED=true
# EAW_OLLAMA_BASE_URL=http://localhost:11434
# EAW_OLLAMA_MODEL=qwen2.5:7b-instruct
# EAW_OLLAMA_TIMEOUT_SECONDS=180

# Optional RDW open-data enrichment (vehicle specifications only, never prices).
# EAW_RDW_ENABLED=false
