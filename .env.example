# Backend configuration for the local FastAPI application.
# Copy to .env and adjust only what you need — every value has a working local default.

# Which market valuations are about. DEMO (default) uses the synthetic demo
# market. REAL values real vehicles on imported market data only and never fills
# a shortage with demo listings; the demo examples keep using the demo market.
# EAW_MARKET_MODE=DEMO

# SQLite database file (absolute path, or relative to where you start the API).
# EAW_DATABASE_PATH=data/automotive.db

# Local AI explanation layer (Ollama). Entirely optional: the valuation, the
# comparables and the result page work unchanged when this is off or the model
# is missing. Nothing is ever downloaded by the application - pull a model
# yourself with `ollama pull <model>`.
#
# The model must follow instructions in Dutch; code models are a poor fit.
# EAW_AI_ENABLED=true
# EAW_OLLAMA_BASE_URL=http://localhost:11434
# EAW_OLLAMA_MODEL=qwen2.5:7b-instruct
# EAW_OLLAMA_TIMEOUT_SECONDS=180

# Plate enrichment from the Dutch open vehicle register (specifications only,
# never prices). The only outbound call the application makes, and only while a
# plate is being looked up. Free, no account and no key. Off by default: the
# application is local-first and reaches the network only when asked to.
# EAW_RDW_ENABLED=false
# EAW_RDW_BASE_URL=https://opendata.rdw.nl/resource
# EAW_RDW_TIMEOUT_SECONDS=6
# An optional free Socrata app token; without one, requests share a throttling
# pool per IP address, which is plenty for local use.
# EAW_RDW_APP_TOKEN=
